# Copier en web/.env.local (jamais versionné)

# true = l'application lit contracts/mocks (copiés dans web/public/mocks) ; false = Supabase
NEXT_PUBLIC_USE_MOCKS=true

# true = bandeau « Maquette » partout, même si les données viennent de Supabase
# (sans cette variable, le bandeau s'affiche dès qu'un nom de zone commence par [FICTIF])
NEXT_PUBLIC_DONNEES_FICTIVES=false

# Supabase : URL du projet et clé anonyme (lecture seule, protégée par RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fond de carte vectoriel (style MapLibre)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Balise affichée par défaut sur l'écran E5
NEXT_PUBLIC_DEFAULT_BALISE_ID=bal-01

# NE JAMAIS mettre ici la clé service_role de Supabase
